    section     = {format=\zihao{-3}\heiti, beforeskip=1.5em, afterskip=0.8em},
    subsection  = {format=\zihao{4}\heiti,  beforeskip=1.0em, afterskip=0.5em},
    subsubsection = {format=\zihao{-4}\heiti, beforeskip=0.8em, afterskip=0.3em},
