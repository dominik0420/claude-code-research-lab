# Venues that require XeLaTeX (CJK / Unicode fonts)
XELATEX_VENUES = {"ctex", "arxiv-cn"}


# ── Markdown → LaTeX conversion ────────────────────────────────────────────────

def escape_latex(text: str) -> str:
    """Escape special LaTeX characters in plain text."""
    replacements = [
        ("\\", r"\textbackslash{}"),
        ("&",  r"\&"),
        ("%",  r"\%"),
        ("$",  r"\$"),
        ("#",  r"\#"),
        ("_",  r"\_"),
        ("{",  r"\{"),
        ("}",  r"\}"),
        ("~",  r"\textasciitilde{}"),
        ("^",  r"\textasciicircum{}"),
    ]
    for ch, rep in replacements:
        text = text.replace(ch, rep)
    return text


def fix_quotes(text: str) -> str:
    """
    Fix quote characters for LaTeX/XeLaTeX output.
    - Straight double quotes "..." → Unicode curly quotes "..." (renders correctly in XeLaTeX)
    - Single quotes '...' → left as-is (LaTeX handles these fine)
    - Chinese quotes "..." and '...' are already correct Unicode, pass through
    """
    # Only convert ASCII straight double quotes; leave Chinese/Unicode quotes alone
    result = []
    i = 0
    open_quote = True
    while i < len(text):
        ch = text[i]
        if ch == '"':
            # Use Unicode curly quotes — XeLaTeX renders them correctly
            result.append('“' if open_quote else '”')
            open_quote = not open_quote
        else:
            result.append(ch)
        i += 1
    return ''.join(result)


def md_inline_to_latex(text: str) -> str:
    """Convert inline markdown (bold, italic, code, links) to LaTeX."""
    # Protect math spans
    math_spans: dict[str, str] = {}
    def protect_math(m: re.Match) -> str:
        key = f"MATHSPAN{len(math_spans)}END"
        math_spans[key] = m.group(0)
        return key
    text = re.sub(r'\$[^$]+\$', protect_math, text)

    # Fix quotes before escaping so we don't mangle them
    text = fix_quotes(text)

    # Bold + italic, bold, italic, code, links
    text = re.sub(r'\*\*\*(.+?)\*\*\*', r'\\textbf{\\textit{\1}}', text)
    text = re.sub(r'\*\*(.+?)\*\*',     r'\\textbf{\1}', text)
    text = re.sub(r'__(.+?)__',         r'\\textbf{\1}', text)
    text = re.sub(r'\*(.+?)\*',         r'\\textit{\1}', text)
    text = re.sub(r'_([^_]+)_',         r'\\textit{\1}', text)
    text = re.sub(r'`([^`]+)`',         r'\\texttt{\1}', text)
    text = re.sub(r'\[([^\]]+)\]\(([^)]+)\)', r'\1\\footnote{\\url{\2}}', text)

    # Restore math spans
    for key, val in math_spans.items():
        text = text.replace(key, val)

    return text


def md_table_to_latex(lines: list[str]) -> str:
    """
    Convert a markdown table block to a LaTeX booktabs table.
    Always wraps in adjustbox so wide tables don't overflow the page.
    """
    rows = []
    for line in lines:
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        rows.append(cells)

    if len(rows) < 2:
        return ""

    header = rows[0]
    body   = rows[2:]   # rows[1] is the separator line — skip
    ncols  = len(header)
    col_spec = "l" * ncols

    out = []
    out.append(r"\begin{table}[htbp]")
    out.append(r"\centering")
    out.append(r"\small")
    out.append(r"\renewcommand{\arraystretch}{1.2}")
    # adjustbox ensures table never overflows — critical for CJK content
    out.append(r"\begin{adjustbox}{max width=\linewidth}")
    out.append(r"\begin{tabular}{" + col_spec + "}")
    out.append(r"\toprule")
    out.append(" & ".join(md_inline_to_latex(h) for h in header) + r" \\")
    out.append(r"\midrule")
    for row in body:
        padded = row + [""] * (ncols - len(row))
        out.append(" & ".join(md_inline_to_latex(c) for c in padded[:ncols]) + r" \\")
    out.append(r"\bottomrule")
    out.append(r"\end{tabular}")
    out.append(r"\end{adjustbox}")
    out.append(r"\end{table}")
    return "\n".join(out)


def md_to_latex(content: str, section_offset: int = 0) -> str:
    """Convert a markdown section draft to LaTeX body content."""
    lines = content.split("\n")
    output = []
    i = 0
    in_list   = False
    list_type = None
    table_buffer: list[str] = []
    in_code   = False
    code_buffer: list[str] = []

    SECTION_CMDS = ["\\section", "\\subsection", "\\subsubsection", "\\paragraph"]

    def flush_list():
        nonlocal in_list, list_type
        if in_list:
            output.append(r"\end{itemize}" if list_type == "ul" else r"\end{enumerate}")
            in_list = False
            list_type = None

    def flush_table():
        nonlocal table_buffer
        if table_buffer:
            output.append(md_table_to_latex(table_buffer))
            table_buffer = []

    while i < len(lines):
        line = lines[i]

        # Code blocks
        if line.strip().startswith("```"):
            flush_list(); flush_table()
            if not in_code:
                in_code = True; code_buffer = []
            else:
                in_code = False
                output.append(r"\begin{verbatim}")
                output.extend(code_buffer)
                output.append(r"\end{verbatim}")
                code_buffer = []
            i += 1; continue

        if in_code:
            code_buffer.append(line); i += 1; continue

        # Table rows
        if line.strip().startswith("|"):
            flush_list()
            table_buffer.append(line); i += 1; continue
        elif table_buffer:
            flush_table()

        # Headings
        hm = re.match(r'^(#{1,4})\s+(.*)', line)
        if hm:
            flush_list(); flush_table()
            level = len(hm.group(1)) - 1 + section_offset
            level = min(level, len(SECTION_CMDS) - 1)
            cmd   = SECTION_CMDS[level]
            title = md_inline_to_latex(hm.group(2))
            output.append(f"{cmd}{{{title}}}")
            i += 1; continue

        # Horizontal rules
        if re.match(r'^---+$', line.strip()) or re.match(r'^\*\*\*+$', line.strip()):
            flush_list()
            output.append(r"\noindent\rule{\linewidth}{0.4pt}")
            i += 1; continue

        # Unordered lists
        ul = re.match(r'^(\s*)[-*+]\s+(.*)', line)
        if ul:
            if not in_list or list_type != "ul":
                flush_list()
                output.append(r"\begin{itemize}"); in_list = True; list_type = "ul"
            output.append(f"  \\item {md_inline_to_latex(ul.group(2))}")
            i += 1; continue

        # Ordered lists
        ol = re.match(r'^(\s*)\d+[.)]\s+(.*)', line)
        if ol:
            if not in_list or list_type != "ol":
                flush_list()
                output.append(r"\begin{enumerate}"); in_list = True; list_type = "ol"
            output.append(f"  \\item {md_inline_to_latex(ol.group(2))}")
            i += 1; continue

        # End of list on blank line
        if in_list and line.strip() == "":
            flush_list(); output.append(""); i += 1; continue

        # Blockquotes
        bq = re.match(r'^>\s*(.*)', line)
        if bq:
            flush_list()
            output.append(r"\begin{quote}")
            output.append(md_inline_to_latex(bq.group(1)))
            output.append(r"\end{quote}")
            i += 1; continue

        # Blank lines
        if line.strip() == "":
            flush_list(); output.append(""); i += 1; continue

        # Regular paragraph text
        flush_list()
        output.append(md_inline_to_latex(line))
        i += 1

    flush_list()
    flush_table()

    return "\n".join(output)


# ── Outline parsing ────────────────────────────────────────────────────────────

# Sections to skip when building the document body
_SKIP_SECTION_PATTERNS = [
    r'^受众导航',
    r'^图表映射',
    r'^写作前',
    r'^open.?question',
    r'^figure.?map',
]

_ABSTRACT_NAMES = {"abstract", "执行摘要", "摘要", "executive summary"}

# Strip word-count annotations like （~300字）or (～600字)
_WORD_COUNT_RE = re.compile(r'[（(][^）)]*[字词words][^）)]*[）)]')

# Strip Chinese ordinal prefixes: 一、 二、 三、 ... (keep the rest of the title)
_CN_ORDINAL_RE = re.compile(
    r'^[一二三四五六七八九十百]+[、．.]'
)


def clean_section_name(raw: str) -> str:
    """
    Strip planning annotations from an outline section name.
    '二、理论框架：四维编码体系（~1500字）' → '二、理论框架：四维编码体系'
    """
    s = _WORD_COUNT_RE.sub('', raw)
    s = s.strip(' ：:')
    return s


def should_skip_section(name: str) -> bool:
    nl = name.lower()
    if nl in _ABSTRACT_NAMES:
        return True
    for pat in _SKIP_SECTION_PATTERNS:
        if re.search(pat, name, re.IGNORECASE):
            return True
    return False


def parse_outline(outline_path: Path) -> dict:
    result = {
        "title":       "Research Paper",
        "authors":     "",
        "affiliation": "",
        "date":        r"\today",
        "abstract":    "",
        "keywords":    "",
        "sections":    [],
    }

    if not outline_path.exists():
        return result

    text  = outline_path.read_text(encoding="utf-8", errors="ignore")
    lines = text.split("\n")

    # ── Title (first # heading) ──────────────────────────────────────────────
    for line in lines:
        m = re.match(r'^#\s+(.*)', line)
        if m:
            t = m.group(1).strip()
            # Strip "论文大纲：" / "Paper Outline:" prefix if present
            t = re.sub(r'^(论文大纲\s*[：:]\s*|Paper\s+Outline\s*[:\s]+)', '', t)
            # Strip subtitle after 暨/—
            t = re.sub(r'\s*[暨—–]\s.*$', '', t)
            result["title"] = t.strip()
            break

    # ── Author / affiliation ──────────────────────────────────────────────────
    for line in lines:
        if re.search(r'\b(author|作者)\b', line, re.IGNORECASE) and re.search(r'[：:]', line):
            val = re.split(r'[：:]', line, maxsplit=1)[1].strip().strip('*').strip()
            if val:
                result["authors"] = val
                break

    # ── Keywords ──────────────────────────────────────────────────────────────
    for line in lines:
        if re.search(r'关键词[：:]|keywords?\s*[：:]', line, re.IGNORECASE):
            val = re.split(r'[：:]', line, maxsplit=1)[-1].strip()
            if val:
                result["keywords"] = val
                break

    # ── Abstract ─────────────────────────────────────────────────────────────
    abs_re    = re.compile(r'^#{1,3}\s+(' + '|'.join(_ABSTRACT_NAMES) + r')', re.IGNORECASE)
    abs_start = None
    for i, line in enumerate(lines):
        if abs_re.match(line):
            abs_start = i + 1
            break
    if abs_start is not None:
        abs_lines = []
        for line in lines[abs_start:]:
            if re.match(r'^#{1,3}\s+', line):
                break
            # Skip bullet-point planning notes (lines starting with - or *)
            if re.match(r'^\s*[-*]', line):
                continue
            if line.strip():
                abs_lines.append(line.strip())
        result["abstract"] = " ".join(abs_lines)

    # ── Sections ─────────────────────────────────────────────────────────────
    # Collect all ## and ### headings after the abstract
    seen_abstract = False
    for line in lines:
        if abs_re.match(line):
            seen_abstract = True
            continue
        if not seen_abstract:
            continue
        m = re.match(r'^#{2,3}\s+(.*)', line)
        if m:
            sec = clean_section_name(m.group(1))
            if sec and not should_skip_section(sec):
                result["sections"].append(sec)

    return result


def find_draft(drafts_dir: Path, section_name: str) -> Path | None:
    """
    Find the draft file that corresponds to a section name.
    Handles Chinese ordinal prefixes (一、二、三) and word-count annotations.
    """
    def normalize(s: str) -> str:
        s = _WORD_COUNT_RE.sub('', s)  # strip （~600字）
        s = s.lower()
        s = re.sub(r'[^a-z0-9一-鿿]', '', s)  # keep alphanum + CJK
        return s

    target     = normalize(section_name)
    # Also try without the Chinese ordinal prefix
    target_no_ordinal = normalize(_CN_ORDINAL_RE.sub('', section_name))

    candidates = list(drafts_dir.glob("*.md"))

    for f in candidates:
        fn = normalize(f.stem)
        if fn == target or fn == target_no_ordinal:
            return f
    for f in candidates:
        fn = normalize(f.stem)
        if target in fn or fn in target:
            return f
        if target_no_ordinal and (target_no_ordinal in fn or fn in target_no_ordinal):
            return f
    return None


def read_status(papers_dir: Path) -> dict:
    status_path = papers_dir / "STATUS.md"
    statuses: dict[str, str] = {}
    if not status_path.exists():
        return statuses
    for line in status_path.read_text(encoding="utf-8", errors="ignore").split("\n"):
        m = re.match(r'.*\|\s*([^|]+?)\s*\|\s*(DRAFT|REVIEWED|APPROVED)\s*\|', line)
        if m:
            statuses[m.group(1).strip().lower()] = m.group(2).strip()
    return statuses


# ── Main assembler ─────────────────────────────────────────────────────────────

def assemble(outline_path: Path, drafts_dir: Path, output_path: Path,
             venue: str, no_compile: bool) -> list[str]:
    messages: list[str] = []
    papers_dir = outline_path.parent

    meta      = parse_outline(outline_path)
    statuses  = read_status(papers_dir)
    preamble  = VENUE_PREAMBLES.get(venue, VENUE_PREAMBLES["article"])

    doc: list[str] = []
    doc.append(preamble)
    doc.append("")

    # Title block
    title   = meta["title"]   or "Research Paper"
    authors = meta["authors"] or "Author"
    doc.append(f"\\title{{{md_inline_to_latex(title)}}}")
    doc.append("")
    if meta["affiliation"]:
        doc.append(f"\\author{{{md_inline_to_latex(authors)} \\\\ "
                   f"\\small {md_inline_to_latex(meta['affiliation'])}}}")
    else:
        doc.append(f"\\author{{{md_inline_to_latex(authors)}}}")
    doc.append("")
    doc.append(f"\\date{{{meta['date']}}}")
    doc.append("")
    doc.append(r"\begin{document}")
    doc.append(r"\maketitle")
    doc.append("")

    # Abstract
    abstract_text = ""
    if meta["abstract"]:
        abstract_text = meta["abstract"]
    else:
        abs_draft = find_draft(drafts_dir, "abstract") or find_draft(drafts_dir, "执行摘要")
        if abs_draft:
            raw = abs_draft.read_text(encoding="utf-8", errors="ignore")
            raw = re.sub(r'^---.*?---\s*', '', raw, flags=re.DOTALL)
            raw = re.sub(r'^#{1,3}[^\n]*\n', '', raw, count=1)
            abstract_text = raw.strip()

    if abstract_text:
        doc.append(r"\begin{abstract}")
        doc.append(md_inline_to_latex(abstract_text))
        doc.append(r"\end{abstract}")
    else:
        doc.append(r"\begin{abstract}")
        doc.append(r"% TODO: Write abstract / 执行摘要")
        doc.append(r"\end{abstract}")
        messages.append("WARNING: No abstract found — placeholder inserted.")

    if meta["keywords"]:
        doc.append(f"\\keywords{{{md_inline_to_latex(meta['keywords'])}}}")

    doc.append("")

    # Sections
    section_order = meta["sections"]
    if not section_order:
        all_drafts = sorted(drafts_dir.glob("*.md"))
        section_order = [
            f.stem.replace("-", " ").title()
            for f in all_drafts
            if f.stem.lower() not in ("abstract", "执行摘要")
        ]
        messages.append("NOTE: No section order in outline — using alphabetical draft order.")

    included: list[str] = []
    missing:  list[str] = []

    for section in section_order:
        if section.lower() in _ABSTRACT_NAMES:
            continue

        draft_file  = find_draft(drafts_dir, section)
        sec_key     = section.lower()
        sec_status  = statuses.get(sec_key, "DRAFT")

        if draft_file is None:
            doc.append(f"% ── MISSING: {section} ──")
            doc.append(f"\\section{{{md_inline_to_latex(section)}}}")
            doc.append(f"% TODO: run /write-section for this section")
            doc.append("")
            missing.append(section)
            messages.append(f"WARNING: No draft for '{section}'.")
            continue

        content = draft_file.read_text(encoding="utf-8", errors="ignore")
        content = re.sub(r'^---.*?---\s*', '', content, flags=re.DOTALL)
        content = re.sub(r'^#{1,3}[^\n]*\n', '', content, count=1)

        if sec_status != "APPROVED":
            doc.append(f"% [{sec_status}] {section}")

        doc.append(f"\\section{{{md_inline_to_latex(section)}}}")
        doc.append(md_to_latex(content.strip()))
        doc.append("")
        included.append(section)

    # References
    bib_path     = papers_dir.parent / "literature" / "bibliography.bib"
    alt_bib_path = papers_dir / "references.bib"

    doc.append(r"\newpage")
    if bib_path.exists():
        doc.append(r"\bibliographystyle{plainnat}")
        doc.append(f"\\bibliography{{{str(bib_path.with_suffix(''))}}}")
    elif alt_bib_path.exists():
        doc.append(r"\bibliographystyle{plainnat}")
        doc.append(f"\\bibliography{{{str(alt_bib_path.with_suffix(''))}}}")
    else:
        doc.append(r"\begin{thebibliography}{99}")
        doc.append(r"% TODO: Add references")
        doc.append(r"\end{thebibliography}")

    doc.append("")
    doc.append(r"\end{document}")

    output_path.parent.mkdir(parents=True, exist_ok=True)
    output_path.write_text("\n".join(doc), encoding="utf-8")

    if included:
        messages.insert(0, f"OK: Included: {', '.join(included)}")
    if missing:
        messages.insert(1, f"MISSING: {', '.join(missing)}")

    return messages


# ── PDF compilation ────────────────────────────────────────────────────────────

def try_engine(engine: str, tex_path: Path) -> tuple[bool, str]:
    """Try one LaTeX engine. Returns (success, message)."""
    if not shutil.which(engine):
        return False, f"{engine}: not found in PATH"

    out_dir = tex_path.parent
    cmd = [
        engine,
        "-interaction=nonstopmode",
        f"-output-directory={out_dir}",
        str(tex_path),
    ]

    for _pass in range(2):  # two passes for TOC / cross-refs
        try:
            result = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
        except subprocess.TimeoutExpired:
            return False, f"{engine}: timed out after 120 s"
        except Exception as e:
            return False, f"{engine}: {e}"

    pdf_path = tex_path.with_suffix(".pdf")
    if pdf_path.exists():
        return True, f"PDF → {pdf_path}"

    log_lines = (result.stdout + result.stderr).split("\n")
    errors    = [l for l in log_lines if l.startswith("!") or "Error" in l][:8]
    return False, f"{engine} failed:\n" + "\n".join(errors)


def try_tectonic(tex_path: Path) -> tuple[bool, str]:
    if not shutil.which("tectonic"):
        return False, "tectonic: not found in PATH"
    try:
        result = subprocess.run(
            ["tectonic", str(tex_path)],
            capture_output=True, text=True, timeout=300,
        )
        pdf_path = tex_path.with_suffix(".pdf")
        if pdf_path.exists():
            return True, f"PDF → {pdf_path}"
        return False, f"tectonic failed: {result.stderr[:300]}"
    except Exception as e:
        return False, f"tectonic: {e}"


def compile_pdf(tex_path: Path, venue: str) -> tuple[bool, str]:
    """
    Try multiple LaTeX engines in order.
    CJK venues need XeLaTeX; try it first.
    """
    needs_xelatex = venue in XELATEX_VENUES

    if needs_xelatex:
        engines = ["xelatex", "lualatex"]
    else:
        engines = ["pdflatex", "xelatex", "lualatex"]

    attempts: list[str] = []

    for engine in engines:
        ok, msg = try_engine(engine, tex_path)
        if ok:
            return True, msg
        attempts.append(msg)

    # Try tectonic last (it auto-downloads packages — great for Overleaf-less setups)
    ok, msg = try_tectonic(tex_path)
    if ok:
        return True, msg
    attempts.append(msg)

    # All failed — give helpful install instructions
    if needs_xelatex:
        hint = (
            "This document uses CJK (ctexart) and requires XeLaTeX or LuaLaTeX.\n\n"
            "Install options:\n"
            "  Windows : winget install MiKTeX.MiKTeX\n"
            "            (then open MiKTeX Console → Install missing packages automatically)\n"
            "  macOS   : brew install --cask mactex\n"
            "  Linux   : sudo apt install texlive-xetex texlive-lang-chinese\n"
            "  Any OS  : install Tectonic (auto-downloads packages):\n"
            "            https://tectonic-typesetting.github.io\n\n"
            "Or upload main.tex to https://overleaf.com → Compiler → XeLaTeX"
        )
    else:
        hint = (
            "Install options:\n"
            "  Windows : winget install MiKTeX.MiKTeX\n"
            "  macOS   : brew install --cask mactex\n"
            "  Linux   : sudo apt install texlive-full\n"
            "  Any OS  : https://tectonic-typesetting.github.io\n\n"
            "Or upload main.tex to https://overleaf.com"
        )

    return False, (
        "No working LaTeX engine found.\n\n"
        + hint
        + "\n\nAttempts:\n"
        + "\n".join(f"  {a}" for a in attempts)
    )


# ── CLI entry point ────────────────────────────────────────────────────────────

def main() -> None:
    parser = argparse.ArgumentParser(
        description="Assemble markdown drafts → LaTeX paper → PDF"
    )
    parser.add_argument("--outline",    default="papers/outline.md",
                        help="Path to outline.md")
    parser.add_argument("--drafts-dir", default="papers/drafts",
                        help="Directory containing section draft .md files")
    parser.add_argument("--output",     default="papers/main.tex",
                        help="Output .tex file path")
    parser.add_argument("--venue",      default="arxiv-cn",
                        choices=sorted(VENUE_PREAMBLES.keys()),
                        help="Paper venue / template to use")
    parser.add_argument("--no-compile", action="store_true",
                        help="Skip PDF compilation (generate .tex only)")
    args = parser.parse_args()

    outline_path = Path(args.outline)
    drafts_dir   = Path(args.drafts_dir)
    output_path  = Path(args.output)
    venue        = args.venue

    if not outline_path.exists():
        print(f"ERROR: Outline not found: {outline_path}", file=sys.stderr)
        sys.exit(1)

    if not drafts_dir.exists() or not any(drafts_dir.glob("*.md")):
        print(f"ERROR: No draft .md files found in {drafts_dir}", file=sys.stderr)
        sys.exit(1)

    print(f"Assembling  {drafts_dir}/ → {output_path}  [venue: {venue}]")
    messages = assemble(outline_path, drafts_dir, output_path, venue, args.no_compile)

    print("\n── Assembly ─────────────────────────────────────────")
    for msg in messages:
        print(f"  {msg}")
    print(f"\n  LaTeX written: {output_path}")

    if args.no_compile:
        print("\n  [--no-compile] Skipping PDF compilation.")
        sys.exit(0)

    print("\n── Compiling PDF ────────────────────────────────────")
    success, log = compile_pdf(output_path, venue)

    if success:
        print(f"  ✅  {log}")
    else:
        print(f"  ❌  {log}")
        sys.exit(2)


if __name__ == "__main__":
    main()
