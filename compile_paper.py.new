\renewenvironment{abstract}{%
    \noindent{\zihao{-4}\heiti 摘\quad 要：}\small\ignorespaces
}{\par\vspace{0.5em}}
% Keywords command
\newcommand{\keywords}[1]{\par\noindent{\zihao{-4}\heiti 关键词：}\small #1\par\vspace{1em}}
